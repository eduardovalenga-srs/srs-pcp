# Supabase — projeto criado em https://supabase.com
# Copie este arquivo para .env.local e preencha com os valores do seu projeto
# (Supabase Dashboard > Project Settings > API)

# Pública: usada no browser e no servidor (segura para expor)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Privada: APENAS no servidor — usada só em src/lib/supabase/admin.ts
# (gestão de usuários no Auth: criar conta, último acesso, link de recuperação).
# Nunca importe esta variável em componentes React.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: limite de upload da planilha Excel em bytes (padrão 20 MB)
# IMPORT_MAX_FILE_SIZE=20971520
